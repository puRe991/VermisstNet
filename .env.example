# ── Datenbank (PostgreSQL 15+ mit PostGIS 3) ──
DATABASE_URL="postgresql://vermisst:vermisst@localhost:5432/vermisstatlas?schema=public"

# Öffentliche Basis-URL (für Origin-/CSRF-Prüfung und absolute Links)
APP_URL="http://localhost:3000"

# 32-Byte-Schlüssel (base64) für die Verschlüsselung von Kontaktdaten (AES-256-GCM).
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=""

# Geheimnis für HMAC von IP-Adressen (Rate Limiting / Missbrauchserkennung). Beliebig lang, zufällig.
IP_HASH_SECRET=""

# Ablageort für Uploads (außerhalb von public/!). Relativ zum Projektverzeichnis oder absolut.
STORAGE_DIR="./storage"

# Kachelserver der Karte. Für Produktion eigenen Tile-Server oder kommerziellen Anbieter verwenden
# (OSM-Tile-Usage-Policy beachten).
NEXT_PUBLIC_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_TILE_ATTRIBUTION="&copy; OpenStreetMap-Mitwirkende"

# Session-Dauer in Stunden
SESSION_TTL_HOURS="12"

# Hinter einem Reverse Proxy: "true", damit X-Forwarded-For für Rate Limiting genutzt wird
TRUST_PROXY="false"
